  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint src tests scripts playwright*.config.ts drizzle.config.ts",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "db:push": "drizzle-kit push",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "node scripts/migrate-database.mjs",
    "typecheck": "tsc --noEmit",
    "test:e2e": "playwright test",
    "test:functional": "playwright test --config=playwright.db.config.ts && playwright test",
    "db:check": "node scripts/check-database.mjs",
    "test:db": "playwright test --config=playwright.db.config.ts",
    "yoco:webhook": "node scripts/register-yoco-webhook.mjs"
  },
  "dependencies": {
    "@clerk/nextjs": "^7.9.18",
    "drizzle-orm": "^0.45.4",
    "fflate": "^0.8.3",
