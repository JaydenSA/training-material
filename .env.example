# No credentials are required for the client demo.
# demo = browser simulation; yoco_test = Yoco sandbox; live = real payments.
TIPIT_MODE=demo
TIPIT_STORAGE=auto
NEXT_PUBLIC_APP_URL=http://localhost:3001

# Clerk and PostgreSQL enable authenticated, persistent restaurant workspaces.
# Yoco merchant onboarding and verified payment processing are still separate.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
NEXT_PUBLIC_AUTH_MODE=auto
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
DATABASE_URL=
# Server-only mapping, keyed by the Clerk organization ID shown in Payments settings.
# Add the test key locally, then register the webhook to save its signing secret.
# YOCO_MERCHANTS_JSON='{"org_REPLACE":{"secretKey":"sk_test_REPLACE","webhookSecret":"whsec_REPLACE"}}'
YOCO_MERCHANTS_JSON='{}'

# Subscription provider has not been selected. Billing remains a demo preview.
