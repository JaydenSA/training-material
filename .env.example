# No credentials are required for the client demo.
TIPIT_MODE=demo
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Integration preparation only. Adding keys does not enable live payments.
# Live authentication, tenant repositories and merchant onboarding still need wiring.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
NEXT_PUBLIC_AUTH_MODE=demo
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
DATABASE_URL=
# Store per-restaurant merchant secret references in the database, never a shared
# platform merchant key used for every restaurant.
YOCO_WEBHOOK_SECRET=

# Subscription provider has not been selected. Billing remains a demo preview.
